# PostgreSQL configuration for development — replace placeholder values before use
DB_CLIENT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=parking_app
DB_USER=parking_user
DB_PASSWORD=your_secure_password_here

# Convenience full connection string (used by many ORMs/drivers)
DATABASE_URL=postgresql://parking_user:your_secure_password_here@127.0.0.1:5432/parking_app

# Optional tuning
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10